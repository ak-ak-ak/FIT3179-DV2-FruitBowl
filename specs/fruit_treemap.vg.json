{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Area encodes nominal farmgate value of 29 reported fruits. Colours identify ten comparison fruits; other categories are grey.",
  "width": 1000,
  "height": 430,
  "padding": 0,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "data": [
    {
      "name": "tree",
      "url": "data/fruit_value_tree.json",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "method": "squarify",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 2,
          "round": false
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "nameLabels",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.x1 - datum.x0 >= 72 && datum.y1 - datum.y0 >= 30"
        }
      ]
    },
    {
      "name": "valueLabels",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.x1 - datum.x0 >= 72 && datum.y1 - datum.y0 >= 52"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "fruitGroup",
      "type": "ordinal",
      "domain": [
        "Apples",
        "Pears",
        "Table grapes",
        "Oranges",
        "Mandarins",
        "Bananas",
        "Mangoes",
        "Avocados",
        "Strawberries",
        "Blueberries"
      ],
      "range": [
        "#ce6777",
        "#799e55",
        "#716096",
        "#dd952f",
        "#d37339",
        "#b89d32",
        "#cb624f",
        "#398965",
        "#bc466d",
        "#506794"
      ]
    }
  ],
  "legends": [],
  "marks": [
    {
      "type": "rect",
      "name": "fruitTiles",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "indexof([\"Apples\", \"Pears\", \"Table grapes\", \"Oranges\", \"Mandarins\", \"Bananas\", \"Mangoes\", \"Avocados\", \"Strawberries\", \"Blueberries\"], datum.fruit) >= 0 ? scale('fruitGroup', datum.fruit) : '#c5cbd2'"
          },
          "tooltip": {
            "signal": "{'Fruit': datum.fruit, 'Farmgate value': '$' + format(datum.value, ',.1f') + ' million', 'Share of reported value': format(datum.share_pct, '.1f') + '%', 'Year': '2024\u201325'}"
          }
        },
        "hover": {
          "stroke": {
            "value": "#263a32"
          },
          "strokeWidth": {
            "value": 2
          }
        },
        "leave": {
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "nameLabels"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 10"
          },
          "text": {
            "field": "fruit"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Nunito Sans"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "signal": "indexof(['Table grapes','Avocados','Strawberries','Blueberries'],datum.fruit) >= 0 ? '#ffffff' : '#172c23'"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 16"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "valueLabels"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 30"
          },
          "text": {
            "signal": "'$' + format(datum.value, ',.1f') + 'm'"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Nunito Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "signal": "indexof(['Table grapes','Avocados','Strawberries','Blueberries'],datum.fruit) >= 0 ? '#ffffff' : '#172c23'"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 16"
          }
        }
      }
    }
  ]
}
