{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart comparing production tonnes for ten fruits between 2020-21 and 2024-25. Intermediate years are not shown. Lines connect comparable observations; zero is included on the quantity axis.",
  "width": "container",
  "height": 400,
  "background": "transparent",
  "data": {
    "url": "data/fruit_history.csv",
    "format": {
      "type": "csv",
      "parse": {
        "production_tonnes": "number",
        "farmgate_value_aud_million": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "titlePadding": 12,
      "gridColor": "#AD8596",
      "domain": false,
      "tickColor": "#c4cec6",
      "labelPadding": 12,
      "labelColor": "#34493E",
      "titleColor": "#34493E",
      "gridOpacity": 0.5,
      "gridWidth": 0.7
    },
    "legend": {
      "labelFontSize": 12,
      "symbolStrokeWidth": 3
    }
  },
  "params": [
    {
      "name": "slopeFruit",
      "value": "All fruits",
      "bind": {
        "input": "select",
        "name": "Highlight fruit: ",
        "options": [
          "All fruits",
          "Apples",
          "Pears",
          "Table grapes",
          "Oranges",
          "Mandarins",
          "Bananas",
          "Mangoes",
          "Avocados",
          "Strawberries",
          "Blueberries"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": {
        "field": "year",
        "oneOf": [
          "2020-21",
          "2024-25"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        "2020-21",
        "2024-25"
      ],
      "scale": {
        "padding": 0.5
      },
      "axis": {
        "title": null,
        "labelAngle": 0,
        "ticks": false,
        "grid": false
      }
    },
    "y": {
      "field": "production_tonnes",
      "type": "quantitative",
      "scale": {
        "zero": true
      },
      "axis": {
        "title": "Production (thousand tonnes)",
        "labelExpr": "format(datum.value / 1000, ',.0f')",
        "tickCount": 6,
        "grid": true
      }
    },
    "color": {
      "field": "fruit",
      "type": "nominal",
      "scale": {
        "domain": [
          "Apples",
          "Pears",
          "Table grapes",
          "Oranges",
          "Mandarins",
          "Bananas",
          "Mangoes",
          "Avocados",
          "Strawberries",
          "Blueberries"
        ],
        "range": [
          "#E75C83",
          "#81AE36",
          "#8A58BB",
          "#F39A24",
          "#ED6D38",
          "#D4AD19",
          "#E76643",
          "#25A977",
          "#D93C72",
          "#4F73C8"
        ]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "horizontal",
        "columns": {
          "expr": "width < 500 ? 2 : 5"
        },
        "labelLimit": 120,
        "columnPadding": 14,
        "rowPadding": 7
      }
    },
    "opacity": {
      "condition": {
        "test": "slopeFruit === 'All fruits' || datum.fruit === slopeFruit",
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "fruit",
        "type": "nominal",
        "title": "Fruit"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Financial year"
      },
      {
        "field": "production_tonnes",
        "type": "quantitative",
        "title": "Production (tonnes)",
        "format": ",.0f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 65
      },
      "name": "slope_points"
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2024-25' && indexof(['Oranges', 'Avocados', 'Pears'], datum.fruit) >= 0"
        },
        {
          "calculate": "datum.fruit === 'Avocados' ? \"Avocados +68%\" : datum.fruit === 'Pears' ? \"Pears -42%\" : \"Oranges +21%\"",
          "as": "change_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "change_label",
          "type": "nominal"
        }
      }
    }
  ]
}
