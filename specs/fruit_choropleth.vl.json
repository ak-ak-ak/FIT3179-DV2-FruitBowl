{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Reported fruit tonnes per square kilometre of state land. ABS 2024-25 and Geoscience Australia land areas. Unreported fruit-state observations are not zero.",
  "width": "container",
  "height": 440,
  "background": "transparent",
  "params": [
    {
      "name": "fruitChoice",
      "value": "All reported fruit"
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ]
  },
  "data": {
    "url": "data/au_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "states"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.name + '|' + fruitChoice",
      "as": "joinKey"
    },
    {
      "lookup": "joinKey",
      "from": {
        "data": {
          "url": "data/fruit_state_density.csv",
          "format": {
            "type": "csv",
            "parse": {
              "production_tonnes": "number",
              "land_area_km2": "number",
              "tonnes_per_km2": "number",
              "reported_categories": "number"
            }
          }
        },
        "key": "key",
        "fields": [
          "production_tonnes",
          "land_area_km2",
          "tonnes_per_km2",
          "reported_categories"
        ]
      }
    },
    {
      "calculate": "isValid(datum.production_tonnes) ? 'Reported' : 'Not reported for this fruit'",
      "as": "status"
    },
    {
      "calculate": "isValid(datum.tonnes_per_km2) ? toNumber(datum.tonnes_per_km2) : null",
      "as": "density_number"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#AEBABD",
        "stroke": "#527D88",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Data availability"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.tonnes_per_km2)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#527D88",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "tonnes_per_km2",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "zero": true,
            "range": [
              "#C4E3F0",
              "#07516B"
            ]
          },
          "legend": {
            "title": "Tonnes per km\u00b2 of state land",
            "orient": "bottom",
            "direction": "horizontal",
            "format": ".2f",
            "gradientLength": {
              "expr": "max(160, width - 24)"
            },
            "tickCount": 4,
            "gradientThickness": 12,
            "titleLimit": 350
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "production_tonnes",
            "type": "quantitative",
            "title": "Reported production (tonnes)",
            "format": ",.0f"
          },
          {
            "field": "tonnes_per_km2",
            "type": "quantitative",
            "title": "Tonnes per km\u00b2",
            "format": ".3f"
          },
          {
            "field": "land_area_km2",
            "type": "quantitative",
            "title": "State land area (km\u00b2)",
            "format": ",.0f"
          },
          {
            "field": "reported_categories",
            "type": "quantitative",
            "title": "Reported fruit categories",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "name": "density_finding",
      "transform": [
        {
          "filter": "isValid(datum.tonnes_per_km2)"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "leader_order"
            }
          ],
          "sort": [
            {
              "field": "density_number",
              "order": "descending"
            },
            {
              "field": "properties.name",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.leader_order === 1"
        },
        {
          "calculate": "['Highest reported density', datum.properties.name, format(datum.tonnes_per_km2, '.3f') + ' tonnes per km\u00b2 of state land']",
          "as": "finding"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 700,
        "lineHeight": 17,
        "color": "#263B32"
      },
      "encoding": {
        "x": {
          "value": 8
        },
        "y": {
          "value": -58
        },
        "text": {
          "field": "finding"
        },
        "color": {
          "value": "#263B32"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans",
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal"
    }
  },
  "usermeta": {
    "fruitOptions": [
      "All reported fruit",
      "Apples",
      "Avocados",
      "Bananas",
      "Blueberries",
      "Mandarins",
      "Mangoes",
      "Oranges",
      "Pears",
      "Strawberries",
      "Table grapes"
    ]
  }
}
