{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Equal Earth flow map of Australia's top eight destinations by export tonnes for five fruit categories, calendar 2025. Paths connect representative national locations and do not depict shipping routes. Line widths rescale within each selection.",
  "width": 1000,
  "height": 460,
  "padding": 0,
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "signals": [
    {
      "name": "fruitChoice",
      "value": "All five categories",
      "bind": {
        "input": "select",
        "name": "Fruit: ",
        "options": [
          "All five categories",
          "Table grapes",
          "Apples",
          "Oranges",
          "Mandarins and related citrus",
          "Strawberries"
        ]
      }
    }
  ],
  "data": [
    {
      "name": "sphere",
      "values": [
        {
          "type": "Sphere"
        }
      ]
    },
    {
      "name": "countries",
      "url": "data/world_countries.topojson",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_admin_0_countries"
      }
    },
    {
      "name": "routes",
      "url": "data/fruit_exports.json",
      "format": {
        "type": "json",
        "property": "flows"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.fruit === fruitChoice"
        },
        {
          "type": "collect",
          "sort": {
            "field": "tonnes",
            "order": "descending"
          }
        },
        {
          "type": "geopath",
          "projection": "world",
          "field": "geometry",
          "as": "path"
        },
        {
          "type": "geopoint",
          "projection": "world",
          "fields": [
            "longitude",
            "latitude"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "destinationLabels",
      "source": "routes",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.rank <= 3"
        }
      ]
    },
    {
      "name": "origin",
      "url": "data/fruit_exports.json",
      "format": {
        "type": "json",
        "property": "origin"
      },
      "transform": [
        {
          "type": "geopoint",
          "projection": "world",
          "fields": [
            "longitude",
            "latitude"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    },
    {
      "name": "leadingDestination",
      "source": "routes",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.rank === 1"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "world",
      "type": "equalEarth",
      "rotate": [
        -150,
        0
      ],
      "fit": {
        "signal": "data('sphere')"
      },
      "extent": {
        "signal": "[[12, 12], [width - 12, height - 12]]"
      }
    }
  ],
  "scales": [
    {
      "name": "flowWidth",
      "type": "linear",
      "domain": {
        "data": "routes",
        "field": "tonnes"
      },
      "zero": true,
      "range": [
        0,
        8
      ]
    },
    {
      "name": "fruitColor",
      "type": "ordinal",
      "domain": [
        "All five categories",
        "Table grapes",
        "Apples",
        "Oranges",
        "Mandarins and related citrus",
        "Strawberries"
      ],
      "range": [
        "#25A977",
        "#8A58BB",
        "#E75C83",
        "#F39A24",
        "#ED6D38",
        "#D93C72"
      ]
    },
    {
      "name": "destinationColor",
      "type": "ordinal",
      "domain": [
        "CHN",
        "JPN",
        "IDN",
        "HKG",
        "THA",
        "KOR",
        "VNM",
        "PHL",
        "NZL",
        "PNG",
        "ARE",
        "SGP",
        "MYS",
        "IND",
        "USA",
        "CAN",
        "QAT"
      ],
      "range": [
        "#C43B72",
        "#197E77",
        "#7251B5",
        "#C16D13",
        "#3F6CC1",
        "#A54435",
        "#618C21",
        "#A33399",
        "#087F9C",
        "#197E77",
        "#A54435",
        "#A33399",
        "#618C21",
        "#7251B5",
        "#7251B5",
        "#A36B36",
        "#C43B72"
      ]
    }
  ],
  "legends": [
    {
      "strokeWidth": "flowWidth",
      "title": "Export volume (tonnes)",
      "orient": "bottom",
      "direction": "horizontal",
      "columns": 3,
      "tickCount": 3,
      "format": ",.0f",
      "labelFont": "Nunito Sans",
      "labelFontSize": 12,
      "titleFont": "Nunito Sans",
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "symbolType": "stroke",
      "symbolStrokeColor": {
        "value": "#516A78"
      },
      "symbolSize": 400,
      "columnPadding": 16
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "sphere"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#D9F0FF"
          },
          "stroke": {
            "value": "#d9e3e5"
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "world"
        }
      ]
    },
    {
      "type": "shape",
      "from": {
        "data": "countries"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#CBE8D9"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 0.5
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "world"
        }
      ]
    },
    {
      "type": "path",
      "name": "exportRoutes",
      "from": {
        "data": "routes"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "scale": "destinationColor",
            "field": "destination_code"
          },
          "strokeWidth": {
            "scale": "flowWidth",
            "field": "tonnes"
          },
          "strokeOpacity": {
            "value": 0.85
          },
          "tooltip": {
            "signal": "{'Destination': datum.destination, 'Fruit category': datum.fruit, 'Export volume': format(datum.tonnes, ',.1f') + ' tonnes', 'Share of selected exports': format(datum.share_pct, '.1f') + '%', 'Period': 'Calendar year 2025'}"
          }
        },
        "hover": {
          "strokeOpacity": {
            "value": 1
          }
        },
        "leave": {
          "strokeOpacity": {
            "value": 0.85
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "exportDestinations",
      "from": {
        "data": "routes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "value": 45
          },
          "fill": {
            "scale": "destinationColor",
            "field": "destination_code"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Destination': datum.destination, 'Export volume': format(datum.tonnes, ',.1f') + ' tonnes', 'Share': format(datum.share_pct, '.1f') + '%'}"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "destinationLabels"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "dy": {
            "signal": "datum.destination_code === 'PNG' ? 20 : datum.destination_code === 'NZL' ? (width < 500 ? -20 : 20) : datum.rank === 1 ? -24 : datum.rank === 2 ? -6 : 18"
          },
          "text": {
            "field": "destination"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Nunito Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#263d33"
          }
        }
      }
    },
    {
      "type": "symbol",
      "interactive": false,
      "from": {
        "data": "origin"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "value": 80
          },
          "fill": {
            "value": "#263d33"
          },
          "stroke": {
            "value": "#ffffff"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "origin"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "dy": {
            "value": 14
          },
          "text": {
            "value": "Australia"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "Nunito Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#263d33"
          },
          "dx": {
            "value": -12
          }
        }
      }
    },
    {
      "name": "export_finding",
      "type": "text",
      "interactive": false,
      "from": {
        "data": "leadingDestination"
      },
      "encode": {
        "update": {
          "x": {
            "value": 8
          },
          "y": {
            "value": 6
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Nunito Sans"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 700
          },
          "lineHeight": {
            "value": 17
          },
          "fill": {
            "value": "#263B32"
          },
          "limit": {
            "signal": "width - 16"
          },
          "text": {
            "signal": "['Leading destination: ' + datum.destination, format(datum.share_pct, '.1f') + '% of selected exports']"
          }
        }
      }
    }
  ]
}
