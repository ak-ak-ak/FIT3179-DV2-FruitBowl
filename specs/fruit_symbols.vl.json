{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Regional banana and avocado production, 2024-25. One fixed area scale across fruits. Geographic centroids locate regions, not farms.",
  "width": "container",
  "height": 440,
  "background": "transparent",
  "params": [
    {
      "name": "fruitChoice",
      "value": "Bananas",
      "bind": {
        "input": "select",
        "name": "Fruit: ",
        "options": [
          "Bananas",
          "Avocados"
        ]
      }
    },
    {
      "name": "regionFocus",
      "value": "North Queensland",
      "bind": {
        "input": "select",
        "name": "Region: ",
        "options": [
          "Australia",
          "North Queensland",
          "South-west WA"
        ]
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ],
    "center": {
      "expr": "regionFocus === 'North Queensland' ? [12.5, -17.7] : regionFocus === 'South-west WA' ? [-17, -33] : [0, -28]"
    },
    "scale": {
      "expr": "regionFocus === 'North Queensland' ? min(width * 9, height * 12) : regionFocus === 'South-west WA' ? min(width * 7, height * 9) : min(width * 0.72, height * 1.1)"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D5EED8",
        "stroke": "#91BC9B",
        "strokeWidth": 1,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/fruit_regions_vega.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.fruit === fruitChoice"
        },
        {
          "calculate": "geoCentroid(null, datum)",
          "as": "centroid"
        },
        {
          "calculate": "datum.centroid[0]",
          "as": "longitude"
        },
        {
          "calculate": "datum.centroid[1]",
          "as": "latitude"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.68,
        "stroke": "#3F573F",
        "strokeWidth": 1,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "fruitChoice === 'Bananas'",
            "value": "#D4AD19"
          },
          "value": "#25A977"
        },
        "size": {
          "field": "properties.production_t",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              125000
            ],
            "range": [
              0,
              700
            ]
          },
          "legend": {
            "title": "Production (tonnes)",
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              1000,
              20000,
              100000
            ],
            "format": ",.0f",
            "symbolFillColor": "#71877B"
          }
        },
        "order": {
          "field": "properties.production_t",
          "type": "quantitative",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "properties.fruit",
            "type": "nominal",
            "title": "Fruit"
          },
          {
            "field": "properties.sa2_name_2021",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "properties.production_t",
            "type": "quantitative",
            "title": "Production (tonnes)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/fruit_regions_vega.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.fruit === fruitChoice"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "production_rank"
            }
          ],
          "sort": [
            {
              "field": "properties.production_t",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.production_rank <= 2"
        },
        {
          "calculate": "geoCentroid(null, datum)",
          "as": "centroid"
        },
        {
          "calculate": "datum.centroid[0]",
          "as": "longitude"
        },
        {
          "calculate": "datum.centroid[1]",
          "as": "latitude"
        },
        {
          "calculate": "datum.properties.sa2_code_2021 === '319011499' ? 'Bundaberg South' : datum.properties.sa2_name_2021",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.longitude > 130 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.longitude > 130 ? -18 : 18"
        },
        "dy": {
          "expr": "datum.properties.fruit === 'Bananas' && datum.production_rank === 1 ? -35 : -12"
        },
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#333b33",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans",
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelLimit": 160
    }
  }
}
