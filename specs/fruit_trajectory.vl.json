{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Time-ordered connected scatterplot for a selected fruit: production tonnes versus nominal farmgate value, 2020-21 to 2024-25. Axes adjust to the selected fruit and do not start at zero. Connections represent annual sequence, not causation.",
  "width": "container",
  "height": 400,
  "background": "transparent",
  "data": {
    "url": "data/fruit_history.csv",
    "format": {
      "type": "csv",
      "parse": {
        "production_tonnes": "number",
        "farmgate_value_aud_million": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "titlePadding": 12,
      "gridColor": "#e7ece8",
      "domain": false,
      "tickColor": "#c4cec6"
    },
    "legend": {
      "labelFontSize": 12,
      "symbolStrokeWidth": 3
    }
  },
  "params": [
    {
      "name": "fruitChoice",
      "value": "Apples",
      "bind": {
        "input": "select",
        "name": "Fruit: ",
        "options": [
          "Apples",
          "Pears",
          "Table grapes",
          "Oranges",
          "Mandarins",
          "Bananas",
          "Mangoes",
          "Avocados",
          "Strawberries",
          "Blueberries"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.fruit === fruitChoice"
    }
  ],
  "encoding": {
    "x": {
      "field": "production_tonnes",
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": true
      },
      "axis": {
        "title": "Production (thousand tonnes)",
        "labelExpr": "format(datum.value / 1000, ',.1f')",
        "tickCount": 4
      }
    },
    "y": {
      "field": "farmgate_value_aud_million",
      "type": "quantitative",
      "scale": {
        "zero": false,
        "nice": true
      },
      "axis": {
        "title": "Farmgate value (A$ million)",
        "format": ",.0f",
        "tickCount": 5
      }
    },
    "color": {
      "field": "fruit",
      "type": "nominal",
      "scale": {
        "domain": [
          "Apples",
          "Pears",
          "Table grapes",
          "Oranges",
          "Mandarins",
          "Bananas",
          "Mangoes",
          "Avocados",
          "Strawberries",
          "Blueberries"
        ],
        "range": [
          "#ce6777",
          "#799e55",
          "#716096",
          "#dd952f",
          "#d37339",
          "#b89d32",
          "#cb624f",
          "#398965",
          "#bc466d",
          "#506794"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "fruit",
        "type": "nominal",
        "title": "Fruit"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Financial year"
      },
      {
        "field": "production_tonnes",
        "type": "quantitative",
        "title": "Production (tonnes)",
        "format": ",.0f"
      },
      {
        "field": "farmgate_value_aud_million",
        "type": "quantitative",
        "title": "Farmgate value (A$ million)",
        "format": ",.1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "order": {
          "field": "year",
          "type": "ordinal",
          "sort": "ascending"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "dy": {
          "expr": "(datum.fruit === 'Blueberries' && datum.year === '2023-24') || (datum.fruit === 'Pears' && datum.year === '2022-23') ? 18 : -12"
        },
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "year",
          "type": "ordinal"
        }
      }
    }
  ]
}
